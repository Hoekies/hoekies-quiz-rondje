rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /theme/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|audio/(mpeg|mp3)|video/mp4)');
    }
  }
}
